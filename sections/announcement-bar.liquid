{% liquid
  assign active_blocks = 0

  for block in section.blocks
    if block.settings.enabled
      assign active_blocks = active_blocks | plus: 1
    endif
  endfor

  if section.settings.position == 'above_header'
    assign announcement_z_index = 110
  else
    assign announcement_z_index = 90
  endif
%}

{{ 'section-announcement.css' | asset_url | stylesheet_tag }}
<script src="{{ 'announcement.js' | asset_url }}" defer></script>

<section
  id="AnnouncementBar-{{ section.id }}"
  class="
    px-announcement
    px-announcement--{{ section.settings.type }}
    px-announcement--{{ section.settings.height }}
    px-announcement--{{ section.settings.text_alignment }}
    {% if section.settings.position == 'above_header' %}
      px-announcement--above-header
    {% else %}
      px-announcement--below-header
    {% endif %}
    {% if section.settings.sticky %}
      px-announcement--sticky
    {% endif %}
    {% if section.settings.show_border %}
      px-announcement--border
    {% endif %}
    {% if section.settings.enable_shadow %}
      px-announcement--shadow
    {% endif %}
  "
  data-announcement
  data-announcement-id="{{ section.id }}"
  data-announcement-type="{{ section.settings.type }}"
  data-rotation-delay="{{ section.settings.rotation_delay | times: 1000 }}"
  data-pause-hover="{{ section.settings.pause_on_hover }}"
  data-pause-focus="{{ section.settings.pause_on_focus }}"
  data-dismissible="{{ section.settings.dismissible }}"
  style="
    --announcement-bg: {{ section.settings.background_color }};
    --announcement-text: {{ section.settings.text_color }};
    --announcement-border-color: {{ section.settings.border_color }};

    --announcement-mobile-bg: {{ section.settings.mobile_background_color }};
    --announcement-mobile-text: {{ section.settings.mobile_text_color }};

    --announcement-height-desktop: {{ section.settings.desktop_height }}px;
    --announcement-height-mobile: {{ section.settings.mobile_height }}px;

    --announcement-max-width: {{ section.settings.content_width }}px;

    --announcement-padding-inline: {{ section.settings.padding_inline }}px;
    --announcement-mobile-padding-inline: {{ section.settings.mobile_padding_inline }}px;

    --announcement-font-size-desktop: {{ section.settings.font_size_desktop }}px;
    --announcement-font-size-mobile: {{ section.settings.font_size_mobile }}px;

    --announcement-font-weight: {{ section.settings.font_weight }};
    --announcement-letter-spacing: {{ section.settings.letter_spacing }}px;

    --announcement-item-gap: {{ section.settings.item_gap }}px;

    --announcement-border-width: {{ section.settings.border_width }}px;
    --announcement-radius: {{ section.settings.border_radius }}px;

    --announcement-transition-duration: {{ section.settings.transition_duration }}ms;
    --announcement-marquee-duration: {{ section.settings.marquee_speed }}s;

    --announcement-z-index: {{ announcement_z_index }};
  "
>
  {% if active_blocks > 0 %}

    <div class="px-announcement__inner">

      {% if section.settings.type == 'slider'
        and section.settings.show_arrows
        and active_blocks > 1
      %}
        <button
          type="button"
          class="px-announcement__control px-announcement__control--prev"
          data-announcement-prev
          aria-label="Previous announcement"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M10 3L5 8L10 13"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      {% endif %}

      <div
        class="px-announcement__viewport"
        data-announcement-viewport
      >

        {% case section.settings.type %}

          {% when 'static' %}

            <div class="px-announcement__static">
              {% for block in section.blocks %}
                {% if block.settings.enabled %}
                  {% render 'announcement-item',
                    block: block,
                    class: 'px-announcement__item'
                  %}
                {% endif %}
              {% endfor %}
            </div>

          {% when 'slider' %}

            <div
              class="
                px-announcement__slider
                px-announcement__slider--{{ section.settings.transition }}
              "
              data-announcement-slider
              aria-live="polite"
            >
              {% assign slide_index = 0 %}

              {% for block in section.blocks %}
                {% if block.settings.enabled %}

                  {% render 'announcement-item',
                    block: block,
                    class: 'px-announcement__item px-announcement__slide',
                    slide_index: slide_index
                  %}

                  {% assign slide_index = slide_index | plus: 1 %}

                {% endif %}
              {% endfor %}
            </div>

          {% when 'marquee' %}

            <div
              class="
                px-announcement__marquee
                px-announcement__marquee--{{ section.settings.marquee_direction }}
              "
              data-announcement-marquee
            >
              <div class="px-announcement__marquee-track">

                {% for copy_index in (1..2) %}

                  <div
                    class="px-announcement__marquee-group"
                    {% if copy_index == 2 %}
                      aria-hidden="true"
                    {% endif %}
                  >

                    {% for block in section.blocks %}

                      {% if block.settings.enabled %}

                        {% render 'announcement-item',
                          block: block,
                          class: 'px-announcement__item px-announcement__marquee-item'
                        %}

                        {% unless forloop.last %}
                          {% unless section.settings.separator == 'none' %}
                            <span
                              class="px-announcement__separator"
                              aria-hidden="true"
                            >
                              {% case section.settings.separator %}
                                {% when 'dot' %}
                                  •
                                {% when 'star' %}
                                  ✦
                                {% when 'diamond' %}
                                  ◆
                                {% when 'line' %}
                                  |
                              {% endcase %}
                            </span>
                          {% endunless %}
                        {% endunless %}

                      {% endif %}

                    {% endfor %}

                  </div>

                {% endfor %}

              </div>
            </div>

        {% endcase %}

      </div>

      {% if section.settings.type == 'slider'
        and section.settings.show_arrows
        and active_blocks > 1
      %}
        <button
          type="button"
          class="px-announcement__control px-announcement__control--next"
          data-announcement-next
          aria-label="Next announcement"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M6 3L11 8L6 13"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      {% endif %}

      {% if section.settings.type == 'slider'
        and section.settings.show_pause
        and active_blocks > 1
      %}
        <button
          type="button"
          class="px-announcement__pause"
          data-announcement-pause
          aria-label="Pause announcements"
          aria-pressed="false"
        >
          <svg
            class="px-announcement__pause-icon"
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 3V11M10 3V11"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>

          <svg
            class="px-announcement__play-icon"
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M5 3L10 7L5 11V3Z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      {% endif %}

      {% if section.settings.dismissible %}
        <button
          type="button"
          class="px-announcement__close"
          data-announcement-close
          aria-label="Close announcement"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 4L12 12M12 4L4 12"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </button>
      {% endif %}

    </div>

  {% endif %}
</section>

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "section-announcement-bar",
  "max_blocks": 12,

  "enabled_on": {
    "groups": ["header"]
  },

  "settings": [

    {
      "type": "header",
      "content": "Display"
    },

    {
      "type": "select",
      "id": "type",
      "label": "Announcement type",
      "default": "static",
      "options": [
        {
          "value": "static",
          "label": "Static"
        },
        {
          "value": "slider",
          "label": "Rotating slider"
        },
        {
          "value": "marquee",
          "label": "Marquee"
        }
      ]
    },

    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "default": "above_header",
      "options": [
        {
          "value": "above_header",
          "label": "Above header"
        },
        {
          "value": "below_header",
          "label": "Below header"
        }
      ]
    },

    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky",
      "default": false
    },

    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "Allow customer to close",
      "default": false
    },

    {
      "type": "header",
      "content": "Slider settings"
    },

    {
      "type": "range",
      "id": "rotation_delay",
      "label": "Rotation delay",
      "min": 2,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 5
    },

    {
      "type": "select",
      "id": "transition",
      "label": "Transition",
      "default": "fade",
      "options": [
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "slide",
          "label": "Slide"
        }
      ]
    },

    {
      "type": "range",
      "id": "transition_duration",
      "label": "Transition duration",
      "min": 100,
      "max": 1500,
      "step": 100,
      "unit": "ms",
      "default": 400
    },

    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show previous / next",
      "default": false
    },

    {
      "type": "checkbox",
      "id": "show_pause",
      "label": "Show pause button",
      "default": false
    },

    {
      "type": "header",
      "content": "Marquee settings"
    },

    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee duration",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "s",
      "default": 35,
      "info": "Lower values make the marquee move faster."
    },

    {
      "type": "select",
      "id": "marquee_direction",
      "label": "Direction",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Right to left"
        },
        {
          "value": "right",
          "label": "Left to right"
        }
      ]
    },

    {
      "type": "select",
      "id": "separator",
      "label": "Message separator",
      "default": "dot",
      "options": [
        {
          "value": "dot",
          "label": "Dot"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "diamond",
          "label": "Diamond"
        },
        {
          "value": "line",
          "label": "Line"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },

    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "pause_on_focus",
      "label": "Pause when focused",
      "default": true
    },

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "select",
      "id": "height",
      "label": "Height preset",
      "default": "standard",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "comfortable",
          "label": "Comfortable"
        }
      ]
    },

    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 28,
      "max": 90,
      "step": 1,
      "unit": "px",
      "default": 40
    },

    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 28,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 38
    },

    {
      "type": "range",
      "id": "content_width",
      "label": "Content max width",
      "min": 600,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "default": 1450
    },

    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },

    {
      "type": "range",
      "id": "padding_inline",
      "label": "Desktop horizontal padding",
      "min": 8,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },

    {
      "type": "range",
      "id": "mobile_padding_inline",
      "label": "Mobile horizontal padding",
      "min": 8,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 16
    },

    {
      "type": "range",
      "id": "item_gap",
      "label": "Message spacing",
      "min": 8,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },

    {
      "type": "header",
      "content": "Typography"
    },

    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Desktop font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },

    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Mobile font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },

    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "default": "500",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },

    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -1,
      "max": 3,
      "step": 0.1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "mobile_background_color",
      "label": "Mobile background",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "mobile_text_color",
      "label": "Mobile text",
      "default": "#FFFFFF"
    },

    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show bottom border",
      "default": false
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#333333"
    },

    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },

    {
      "type": "checkbox",
      "id": "enable_shadow",
      "label": "Enable shadow",
      "default": false
    },

    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],

  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",

      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Enable announcement",
          "default": true
        },

        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "Free shipping on orders over ₹999"
        },

        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },

        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "info": "Optional. Leave empty to make the complete message clickable."
        },

        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in new tab",
          "default": false
        },

        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "truck",
              "label": "Shipping"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "tag",
              "label": "Offer"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "info",
              "label": "Info"
            }
          ]
        },

        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "Example: NEW, SALE, LIMITED"
        },

        {
          "type": "checkbox",
          "id": "show_arrow",
          "label": "Show arrow",
          "default": false
        },

        {
          "type": "checkbox",
          "id": "use_custom_background",
          "label": "Use custom message background",
          "default": false
        },

        {
          "type": "color",
          "id": "background_color",
          "label": "Message background",
          "default": "#111111"
        },

        {
          "type": "color",
          "id": "text_color",
          "label": "Message text",
          "default": "#FFFFFF"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Announcement bar",

      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Free shipping on orders over ₹999",
            "icon": "truck"
          }
        },

        {
          "type": "announcement",
          "settings": {
            "text": "10% off your first order",
            "icon": "tag"
          }
        },

        {
          "type": "announcement",
          "settings": {
            "text": "Easy returns & secure payments",
            "icon": "check"
          }
        }
      ]
    }
  ]
}
{% endschema %}